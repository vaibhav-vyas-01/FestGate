# FestGate Environment Configuration

# Flask Secret Key
SECRET_KEY=festgate_super_secret_gatekeeper_token_2026

# Server Port
PORT=5000

# Optional: Firebase Realtime Database Cloud Sync
# (If omitted, FestGate automatically uses the persistent local database festgate_db.json)
FIREBASE_DATABASE_URL=https://your-festgate-project-default-rtdb.firebaseio.com/
FIREBASE_CREDENTIALS=path/to/serviceAccountKey.json

# Optional: Frontend Vite Firebase Web Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-festgate-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-festgate-project-default-rtdb.firebaseio.com/
VITE_FIREBASE_PROJECT_ID=your-festgate-project
VITE_FIREBASE_STORAGE_BUCKET=your-festgate-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
